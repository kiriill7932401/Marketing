<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>ЗОЖ & Спорт — Твой путь к здоровью</title>

<!-- Шрифты и иконки -->
<link href="https://fonts.googleapis.com/css2?family=Inter:300,400,600,700&family=Montserrat:wght@700;800&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />

<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }
  body {
    font-family: 'Inter', sans-serif;
    background-color: #010101;
    color: #eef2ff;
    line-height: 1.5;
  }
  a {
    text-decoration: none;
    color: inherit;
  }
  /* Общие стили */
  .section {
    padding: 80px 20px;
  }
  .container {
    max-width: 1280px;
    margin: 0 auto;
  }
  /* Заголовок и оффер */
  .header {
    padding: 30px 20px;
    background: linear-gradient(135deg, #66bb6a, #43a047);
    text-align: center;
    color: #fff;
  }
  .header h1 {
    font-family: 'Montserrat', sans-serif;
    font-size: 2.8rem;
    margin-bottom: 20px;
  }
  .header p {
    font-size: 1.2rem;
  }
  /* Кнопка */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    background: #28a745;
    color: #fff;
    padding: 14px 36px;
    border-radius: 60px;
    font-weight: 700;
    font-size: 1.05rem;
    margin-top: 20px;
    transition: 0.3s;
  }
  .btn:hover {
    background: #218838;
    transform: scale(1.03);
  }
  /* Общие стили секций */
  h2 {
    font-family: 'Montserrat', sans-serif;
    font-size: 2.2rem;
    margin-bottom: 40px;
    text-align: center;
    position: relative;
  }
  h2 span {
    border-bottom: 3px solid #66bb6a;
    padding-bottom: 8px;
    display: inline-block;
  }
  /* Карточки */
  .cards {
    display: flex;
    flex-wrap: wrap;
    gap: 30px;
    justify-content: center;
  }
  .card {
    background: #0b0e17;
    border-radius: 20px;
    padding: 30px 20px;
    flex: 1 1 280px;
    max-width: 330px;
    transition: transform 0.3s, border-color 0.3s, box-shadow 0.3s;
  }
  .card:hover {
    transform: translateY(-10px);
    border-color: #66bb6a;
    box-shadow: 0 20px 40px rgba(102, 187, 106, 0.4);
  }
  .card i {
    font-size: 2.5rem;
    color: #66bb6a;
    margin-bottom: 20px;
  }
  /* Отзывы и результаты */
  .reviews {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 900px;
    margin: 0 auto;
  }
  .review {
    background: #0b0e17;
    padding: 20px;
    border-radius: 15px;
    border: 1px solid #2a2e3f;
  }
  /* Тарифы */
  .tariffs {
    display: flex;
    flex-wrap: wrap;
    gap: 30px;
    justify-content: center;
  }
  .tariff {
    background: #0b0e17;
    border-radius: 20px;
    padding: 30px 20px;
    flex: 1 1 250px;
    max-width: 300px;
    border: 2px solid transparent;
    transition: border-color 0.3s, box-shadow 0.3s;
  }
  .tariff:hover {
    border-color: #66bb6a;
    box-shadow: 0 20px 40px rgba(102, 187, 106, 0.4);
  }
  /* FAQ */
  .faq {
    max-width: 900px;
    margin: 0 auto;
  }
  .faq-item {
    margin-bottom: 20px;
  }
  .faq-question {
    background: #1f2538;
    padding: 15px;
    border-radius: 10px;
    cursor: pointer;
    font-weight: 600;
  }
  .faq-answer {
    display: none;
    padding: 15px;
    background: #2a2e3f;
    border-radius: 10px;
    margin-top: 8px;
  }
  /* Призыв к действию */
  .cta {
    background: linear-gradient(135deg, #66bb6a, #43a047);
    padding: 40px 20px;
    text-align: center;
    color: #fff;
  }
  .cta h2 {
    font-family: 'Montserrat', sans-serif;
    font-size: 2rem;
    margin-bottom: 20px;
  }
  /* Шапка и подвал */
  header, footer {
    padding: 20px;
    background: #010101;
    text-align: center;
  }
  footer p {
    font-size: 0.9rem;
    color: #7f8aa8;
  }

  /* Адаптив */
  @media(max-width: 768px){
    h1 { font-size: 2rem; }
    .cards { flex-direction: column; align-items: center; }
  }
</style>
</head>
